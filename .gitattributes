# Store text files with LF in the repository, check them out with native endings.
# Without this, Windows CRLF endings leak into commits and every file looks
# modified when the repo is touched from a different OS or from CI.
* text=auto

# Files whose endings must survive regardless of platform.
*.sh    text eol=lf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.sln   text eol=crlf

# Give git a language-aware diff for C#, so hunk headers show the enclosing member.
*.cs    text diff=csharp

# Never normalize or diff these as text.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.snk   binary
*.ttf   binary
*.otf   binary
