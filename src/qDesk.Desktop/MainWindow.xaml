<Window x:Class="qDesk.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:qDesk.Desktop"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:MainViewModel}"
        Title="{Binding ApplicationTitle}"
        Height="450" Width="800"
        Background="#FF101418">
    <Grid Margin="40">
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
            <TextBlock Text="{Binding ApplicationTitle}"
                       Foreground="#FFF5F7FA"
                       FontSize="30"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,10,0,0"
                       Foreground="#FF8B97A6"
                       FontSize="14">
                <Run Text="Environment:" />
                <!-- Mode=OneWay is required, not stylistic: unlike TextBlock.Text, Run.Text binds
                     TwoWay by default, which throws against a get-only source property. -->
                <Run Text="{Binding EnvironmentName, Mode=OneWay}" FontWeight="SemiBold" />
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
